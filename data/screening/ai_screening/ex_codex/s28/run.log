  "id": "R0340",
  "study_type": "Proposed security compliance framework with an initial prototype case study and preliminary comparative analysis",
  "RQ1 task_stage": "Assess static security compliance of CU configuration files; identify non-compliance, generate explainable justifications, and propose remediation",
  "RQ1 domain": "Next-generation RANs, O-RAN and AI-RAN; compliance module deployed in the SMO",
  "RQ1 orientation": "Security assurance and security compliance enforcement",
  "RQ2 architecture": "Compliance Assessment Agent and Reflection Agent with iterative refinement; prototype adds a RAG Query Generator Agent, semantic knowledge base, retrieval and re-ranking tools",
  "RQ2 llm_used": "GPT-4.1 Mini; Gemini 2.5 Flash; Mistral Large-latest",
  "RQ2 adaptation": "RAG and Agentic RAG; OpenAI 1536-dimensional embeddings, cosine similarity and re-ranking; knowledge-base feedback with validated remediation examples",
  "RQ3 autonomy_level": "Prototype retrieves specifications and iteratively assesses compliance; proposed framework autonomously generates corrected configuration/code and applies compliance updates",
  "RQ3 hitl": "Optional human escalation when agents fail to converge; human approval before enforcement, validation and override recommended until operator trust is established",
  "RQ4 dataset": "Approximately 1,000 pages of O-RAN WG11 and eight 3GPP specifications, producing 6,400 chunks of 1,000 characters; four OpenAirInterface configuration files, each evaluated three times",
  "RQ4 environment": "Static CU configuration compliance workflow implemented in N8N; configuration files obtained from OpenAirInterface",
  "RQ4 metrics": "Task accuracy; BERTScore; response time in seconds",
  "RQ4 baseline_type": "Different retrieval configurations across three LLMs",
