{
  "id": "R0480",
  "study_type": "Population-based, gradient-free self-improvement protocol with evaluation on CybORG CAGE-2",
  "RQ1 task_stage": "Network defense; selects defense actions and interprets host-level observations",
  "RQ1 domain": "13-host enterprise network",
  "RQ1 orientation": "Defensive; blue defender against an automated red attacker",
  "RQ2 architecture": "Hierarchical ReAct Planner with on-demand Analyst and ActionChooser sub-agents; Reflector/Exemplifier evolves persistent prompt-injected memory across 10 parallel instances using champion broadcast and graduation",
  "RQ2 llm_used": "Gemini-2.5-Flash-Lite, Grok-4-Fast, Llama-4-Maverick, Qwen3-235B",
  "RQ2 adaptation": "Prompt-only memory evolution without weight updates; failure-triggered Reflexion generates Rules, Examples, or Mixed artifacts",
  "RQ3 autonomy_level": "Selects defense actions; automatically aborts failed episodes, updates memory, restarts episodes, selects and broadcasts champion memory, and freezes graduated instances",
  "RQ3 hitl": "User sets persistent instructions and specific knowledge; human approval or review during operation not stated",
  "RQ4 dataset": "not stated",
  "RQ4 environment": "CybORG CAGE-2 stochastic network-defense POMDP; B_line attacker, 30-step horizon",
  "RQ4 metrics": "Mean evaluation return, graduation rate, total prompt and completion tokens, tail-risk failure frequency",
  "RQ4 baseline_type": "Zero-shot LLM agents and isolated single-stream reflection; no-graduation ablation",
  "RQ4 headline_result": "1.7–7.7× improvement over zero-shot and 29–72% over Reflexion across all 12 model-representation conditions; major-failure rates below −100 reduced to approximately 1%",
  "RQ4 compared_to": "Zero-shot; Reflexion",
  "RQ4 code_available": "yes + https://github.com/isbogdanov/forge-protocol",
  "RQ4 data_available": "not stated",
  "RQ5 risks_addressed": "Counterproductive memory artifacts, high-variance policies and major/catastrophic failures; brittle single-best broadcast and checkpoint-evaluation misalignment",
  "RQ5 mitigations": "Champion selection and broadcast propagate best-performing memory; graduation freezes strong solutions to prevent regression; fixed memory capacity prevents unbounded context growth",
  "author_limitations (verbatim)": "Our study faces limitations in scope (single attacker type, fixed 30-step horizon in one application domain) and protocol dynamics (brittle single-best broadcast, checkpoint-evaluation misalignment). All evidence is confined to CAGE-2 B_line; generalization to other attacker types and POMDP environments remains untested.",
  "author_future_work (verbatim)": "Future work should address these limitations by testing additional attacker variants.",
  "evidence (page/section)": "Study type, tasks, domain, orientation and environment: Abstract, §§1, 4; architecture, adaptation, autonomy and human input: §§3.1–3.3; models, baselines and metrics: §4, Table 2; results: §§5.1, 6, Table 3; code: §8; reliability risks and mitigations: §§2, 3.1–3.3, 7; limitations and future work: §7"
}
END_JSON
