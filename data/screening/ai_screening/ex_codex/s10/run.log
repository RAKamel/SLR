{
  "id": "R0139",
  "study_type": "LLM-based automated penetration testing framework with benchmark evaluation",
  "RQ1 task_stage": "Intelligence gathering, vulnerability analysis, and exploitation; penetration testing report generation",
  "RQ1 domain": "External assessments, especially web penetration testing",
  "RQ1 orientation": "Penetration testing for proactively identifying security vulnerabilities",
  "RQ2 architecture": "Multi-agent collaboration: reconnaissance, search, planning, and execution agents; iterative reconnaissance/exploitation loops, RAG databases, online search and command execution tools",
  "RQ2 llm_used": "GPT-3.5-turbo-0125, GPT-4o, o1-mini, Llama 3.1-8B-Instruct",
  "RQ2 adaptation": "RAG, role-playing, chain-of-thought, self-reflection, structured JSON output; designed system messages and prompts",
  "RQ3 autonomy_level": "Given a target IP, automatically gathers information, identifies exploits, executes and debugs exploits, and stores execution history for reporting",
  "RQ3 hitl": "Human experts can intervene at any testing stage for additional knowledge or user interactions; evaluators manually verify discovered exploits",
  "RQ4 dataset": "67 VulHub targets spanning 32 CWE categories: 50 easy, 11 medium, 6 hard; 11 HackTheBox challenges",
  "RQ4 environment": "Ubuntu 22.04 LTS victim VM hosting vulnerable Docker containers; Kali Linux 2024.1 attacker VM connected via NAT; HackTheBox machines",
  "RQ4 metrics": "End-to-end exploit success rate; stage completion level; elapsed time and API cost",
  "RQ4 baseline_type": "LLM-based penetration testing system requiring human participation; comparisons across LLM backbones",
  "RQ4 headline_result": "Reported GPT-4 overall success rate: 74.2%, versus GPT-3.5: 60.6%; successfully exploited six of 11 HackTheBox machines",
  "RQ4 compared_to": "PentestGPT; GPT-3.5, GPT-4, o1-mini, and Llama 3.1-8B-Instruct backbones",
  "RQ4 code_available": "yes + https://github.com/nbshenxm/pentest-agent",
  "RQ4 data_available": "yes + https://github.com/nbshenxm/pentest-agent",
  "RQ5 risks_addressed": "LLM hallucinations and propagation of incorrect outputs; context loss, repeated tasks, infinite loops, and exploit execution failures",
  "RQ5 mitigations": "CoT stop conditions, structured outputs, RAG persistent memory, and self-reflection for debugging; human intervention for knowledge gaps and manual interactions",
  "author_limitations (verbatim)": "In the intelligence gathering stage, PentestAgent occasionally fails to recognize services or applications with the appropriate level of granularity.",
  "author_future_work (verbatim)": "not stated",
  "evidence (page/section)": "Abstract; §1 Introduction and footnote 1 (framework, public code/data); §2.1 Penetration Testing (domain and purpose); §2.2 Challenges (risks); §§3.1–3.5 System Design (architecture, prompting, autonomy, mitigations); §§4.1.1–4.1.3 and Table 2 (datasets, metrics, environment, models); §4.2 (success rates); §§4.4–4.6 (comparisons and HackTheBox results); §4.7 Failure Analysis (human intervention and limitations). Supplied text ends during §4.7."
}
